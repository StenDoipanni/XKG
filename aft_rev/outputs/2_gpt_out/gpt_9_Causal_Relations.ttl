```turtle
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix fred: <http://www.ontologydesignpatterns.org/ont/fred/domain.owl#> .

fred:win_1 dul:causes fred:celebrate_1 .

fred:achieve_1 dul:causes fred:thrill_1 .

fred:emotion_1 dul:causes fred:exhilarate_1 .

fred:scene_1 dul:causes fred:inspire_1 .

fred:beaming_1 a pbrs:beam-01 ;
    dul:causes fred:celebrate_1 .

fred:pride_1 dul:causes fred:symbolize_1 .
```